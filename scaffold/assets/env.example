# Copy to .env (never committed) and adjust. Every variable the project reads is listed here.

# ---- Postgres (compose.yaml + apps) ----
POSTGRES_VERSION=__CURRENT_MAJOR__        # Postgres major version
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-password     # local only; real environments use their own secret store
POSTGRES_DB=app
DATABASE_URL=postgresql://app:local-dev-password@localhost:5432/app
# Python/SQLAlchemy: the settings module converts the scheme to postgresql+psycopg://

# ---- API ----
API_PORT=8000
SERVICE_NAME=app-api
NODE_ENV=development                     # Node only
ENVIRONMENT=development                  # Python only

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE=../logs/api.ndjson              # relative to api/; unset to log to stdout only
ELASTIC_VERSION=__CURRENT_VERSION__      # Elasticsearch, Kibana and Filebeat share this

# ---- Web (VITE_* values are PUBLIC: they ship in the browser bundle) ----
# VITE_API_BASE_URL=                     # leave unset in dev; the Vite proxy handles /api
